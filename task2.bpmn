        <dc:Bounds x="2650" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2615" y="578" width="106" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OnlineStart_di" bpmnElement="OnlineStart">
        <dc:Bounds x="140" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="220" width="120" height="65" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Register_di" bpmnElement="Register">
        <dc:Bounds x="220" y="150" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Quote_di" bpmnElement="Quote">
        <dc:Bounds x="400" y="150" width="140" height="80" />
      </bpmndi:BPMNShape>
