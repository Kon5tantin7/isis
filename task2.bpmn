<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Registration" targetNamespace="https://example.org/registration"><bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="Регистрация пользователя на сайте" processRef="Process" /></bpmn:collaboration><bpmn:process id="Process" isExecutable="false"><bpmn:laneSet id="Lanes"><bpmn:lane id="User" name="Пользователь"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Input</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="System" name="Система"><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Error</bpmn:flowNodeRef><bpmn:flowNodeRef>Send</bpmn:flowNodeRef><bpmn:flowNodeRef>Activate</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Начало"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Input" name="Ввести имя, email и пароль"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:incoming>F6</bpmn:incoming></bpmn:userTask><bpmn:serviceTask id="Check" name="Проверить корректность данных"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Valid" name="Данные корректны?" default="F5"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Error" name="Показать ошибки ввода"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="Send" name="Отправить письмо для подтверждения"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="Confirm" name="Подтвердить регистрацию по ссылке из письма"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Activate" name="Активировать учётную запись"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End" name="Регистрация успешна"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Input" /><bpmn:sequenceFlow id="F2" sourceRef="Input" targetRef="Check" /><bpmn:sequenceFlow id="F3" sourceRef="Check" targetRef="Valid" /><bpmn:sequenceFlow id="F4" sourceRef="Valid" targetRef="Send" name="Да" /><bpmn:sequenceFlow id="F5" sourceRef="Valid" targetRef="Error" name="Нет" /><bpmn:sequenceFlow id="F6" sourceRef="Error" targetRef="Input" /><bpmn:sequenceFlow id="F7" sourceRef="Send" targetRef="Confirm" /><bpmn:sequenceFlow id="F8" sourceRef="Confirm" targetRef="Activate" /><bpmn:sequenceFlow id="F9" sourceRef="Activate" targetRef="End" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="70" y="80" width="1390" height="580" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="User_di" bpmnElement="User" isHorizontal="true"><dc:Bounds x="100" y="80" width="1360" height="230" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="System_di" bpmnElement="System" isHorizontal="true"><dc:Bounds x="100" y="310" width="1360" height="350" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="150" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="120" y="208" width="110" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Input_di" bpmnElement="Input"><dc:Bounds x="230" y="140" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Check_di" bpmnElement="Check"><dc:Bounds x="440" y="380" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid" isMarkerVisible="true"><dc:Bounds x="645" y="395" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="615" y="355" width="110" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Error_di" bpmnElement="Error"><dc:Bounds x="595" y="535" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Send_di" bpmnElement="Send"><dc:Bounds x="770" y="380" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm"><dc:Bounds x="960" y="140" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Activate_di" bpmnElement="Activate"><dc:Bounds x="1160" y="380" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1370" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1340" y="448" width="110" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="186" y="180" /><di:waypoint x="230" y="180" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="380" y="180" /><di:waypoint x="515" y="180" /><di:waypoint x="515" y="380" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="590" y="420" /><di:waypoint x="645" y="420" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="695" y="420" /><di:waypoint x="770" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="720" y="395" width="30" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="670" y="445" /><di:waypoint x="670" y="535" /><bpmndi:BPMNLabel><dc:Bounds x="680" y="485" width="30" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="595" y="575" /><di:waypoint x="305" y="575" /><di:waypoint x="305" y="220" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="920" y="420" /><di:waypoint x="1040" y="420" /><di:waypoint x="1040" y="220" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1120" y="180" /><di:waypoint x="1235" y="180" /><di:waypoint x="1235" y="380" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1310" y="420" /><di:waypoint x="1370" y="420" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>