        <dc:Bounds x="2170" y="825" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Settle_di" bpmnElement="Settle">
        <dc:Bounds x="2280" y="810" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Close_di" bpmnElement="Close">
        <dc:Bounds x="2460" y="510" width="130" height="80" />
      </bpmndi:BPMNShape>
