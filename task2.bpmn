        <di:waypoint x="2110" y="850" />
        <di:waypoint x="2170" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1910" y="1100" />
        <di:waypoint x="2195" y="1100" />
        <di:waypoint x="2195" y="875" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2035" y="1075" width="30" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="2220" y="850" />
        <di:waypoint x="2280" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <di:waypoint x="2410" y="850" />
        <di:waypoint x="2525" y="850" />
        <di:waypoint x="2525" y="590" />
