<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CarRental" targetNamespace="https://bpmn.io/schema/bpmn" exporter="bpmn-js">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Прокат автомобилей — офис, сайт и мобильное приложение" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Online" name="Информационная система (сайт / приложение)">
        <bpmn:flowNodeRef>OnlineStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Manager" name="Менеджер">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Cashier" name="Кассир">
        <bpmn:flowNodeRef>Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Settle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Technician" name="Сотрудник выдачи и приёма">
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Extra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Клиент обратился в офис">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Request" name="Уточнить автомобиль и сроки проката">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Docs" name="Проверить документы и условия допуска">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Online_3</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Клиент допущен?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Stock" name="Проверить наличие автомобиля на выбранные даты">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Available" name="Автомобиль доступен?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Contract" name="Одобрить заявку и забронировать автомобиль">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Online_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Reject" name="Сообщить причину отказа в офисе или онлайн">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Rejected" name="Прокат не оформлен">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Payment" name="Подтвердить получение оплаты и залога (онлайн или в офисе)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Issue" name="Сверить оригиналы, подписать договор и выдать авто по акту">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Return" name="Принять возвращённый автомобиль">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Inspect" name="Проверить состояние, топливо и срок возврата">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Extra" name="Нужна доплата?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Charge" name="Рассчитать доплату по условиям договора">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Merge" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Settle" name="Выполнить окончательный расчёт и вернуть остаток залога">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Close" name="Закрыть договор и обновить статус автомобиля">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Прокат завершён">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Request" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Request" targetRef="Docs" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Docs" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_4" name="Да" sourceRef="Valid" targetRef="Stock" />
    <bpmn:sequenceFlow id="Flow_5" name="Нет" sourceRef="Valid" targetRef="Reject" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Stock" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_7" name="Да" sourceRef="Available" targetRef="Contract" />
    <bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="Available" targetRef="Reject" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Reject" targetRef="Rejected" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Notify" targetRef="Payment" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Payment" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Issue" targetRef="Return" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Return" targetRef="Inspect" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Inspect" targetRef="Extra" />
    <bpmn:sequenceFlow id="Flow_15" name="Да" sourceRef="Extra" targetRef="Charge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Charge" targetRef="Merge" />
    <bpmn:sequenceFlow id="Flow_17" name="Нет" sourceRef="Extra" targetRef="Merge" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Merge" targetRef="Settle" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Settle" targetRef="Close" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Close" targetRef="End" />
    <bpmn:startEvent id="OnlineStart" name="Получена заявка с сайта или приложения">
      <bpmn:outgoing>Online_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OnlineStart_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Register" name="Зарегистрировать выбранное авто, даты и документы клиента">
      <bpmn:incoming>Online_1</bpmn:incoming>
      <bpmn:outgoing>Online_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Quote" name="Рассчитать стоимость и передать заявку на проверку">
      <bpmn:incoming>Online_2</bpmn:incoming>
      <bpmn:outgoing>Online_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Notify" name="Отправить подтверждение брони, стоимость и ссылку на оплату">
      <bpmn:incoming>Online_4</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Online_1" sourceRef="OnlineStart" targetRef="Register" />
    <bpmn:sequenceFlow id="Online_2" sourceRef="Register" targetRef="Quote" />
    <bpmn:sequenceFlow id="Online_3" sourceRef="Quote" targetRef="Docs" />
    <bpmn:sequenceFlow id="Online_4" sourceRef="Contract" targetRef="Notify" />
    <bpmn:textAnnotation id="OnlineNote">
      <bpmn:text>Клиент на сайте или в приложении: выбирает автомобиль и даты, указывает контакты, загружает документы и отправляет заявку. Оплата — онлайн по ссылке или при получении.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="60" y="90" width="2680" height="1140" />
      </bpmndi:BPMNShape>
