        <dc:Bounds x="1860" y="1075" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1825" y="1135" width="120" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Charge_di" bpmnElement="Charge">
        <dc:Bounds x="1980" y="810" width="130" height="80" />
      </bpmndi:BPMNShape>
